# ===========================================
# ANVAGO ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anvago?schema=public"

# JWT Authentication
JWT_SECRET="anvago-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# OAuth - Google (get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OAuth - Facebook (get from https://developers.facebook.com)
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

# External APIs
GOOGLE_PLACES_API_KEY="your-google-places-api-key"
MAPBOX_ACCESS_TOKEN="your-mapbox-access-token"
OPENWEATHER_API_KEY="your-openweather-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# App Configuration
NODE_ENV="development"
PORT=3001
CLIENT_URL="http://localhost:5173"

# Admin Panel
ADMIN_EMAIL="admin@anvago.com"
ADMIN_PASSWORD="anvago-admin-2024"

# Demo Mode
DEMO_MODE="true"

# SEPAY Payment Gateway (https://my.sepay.vn — register as individual, no business license needed)
# Get credentials from: my.sepay.vn → Payment Gateway → Register → Node.js SDK
SEPAY_MERCHANT_ID="your-merchant-id"
SEPAY_SECRET_KEY="your-secret-key"
SEPAY_ENV="sandbox"  # "sandbox" or "production"
# SERVER_URL must be publicly accessible for SEPAY IPN webhook
# Configure IPN in: my.sepay.vn → Payment Gateway → Configuration → IPN
# Use ngrok (e.g. https://abc123.ngrok.io) during local development
SERVER_URL="http://localhost:3001"

